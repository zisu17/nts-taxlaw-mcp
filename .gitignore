# ─── Python 바이트코드·빌드 산출물 ──────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
sdist/
wheels/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# ─── 가상환경 ──────────────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── 테스트·커버리지·타입검사 캐시 ─────────────────────────────────────────
.pytest_cache/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# ─── 환경변수 (NTS_* 설정을 로컬 파일로 두는 경우) ──────────────────────────
# 기본값만으로 동작하므로 커밋할 이유가 없다. README 8절 참조.
.env
.env.*
!.env.example

# ─── 에디터·IDE ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.ipynb_checkpoints/

# ─── OS ────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ─── Claude Code ───────────────────────────────────────────────────────────
# settings.json 은 팀 공유용이라 커밋하고, local 만 제외한다.
.claude/settings.local.json

# ─── uv ────────────────────────────────────────────────────────────────────
# uv.lock 은 **커밋한다**. 이 프로젝트는 라이브러리가 아니라 실행되는 서버라서,
# 사무용 PC 어디에 설치해도 같은 버전이 깔리는 편이 낫다.
# 갱신은 `uv lock --upgrade` 로 한다.
.python-version

# ─── 테스트 (원격 저장소에 두지 않는다) ────────────────────────────────────
# 이 저장소의 독자는 서버를 설치해서 쓰는 사람이다. 테스트는 wheel 에 포함되지도
# 않으므로(실측 확인) 사용자에게 아무 역할이 없다. 유지보수용으로 로컬에만 둔다.
# 되살리려면 .gitignore 에서 아래 두 줄을 지우고 git add tests scripts 하면 된다.
tests/
scripts/refresh_fixtures.py

# ─── 이 프로젝트에서 생기는 임시 산출물 ────────────────────────────────────
# 조사·디버깅 중 저장한 원본 응답 덤프나 페이지 스냅샷.
# tests/fixtures/ 의 정식 fixture 와 헷갈리지 않게 별도 경로를 쓴다.
scratch/
tmp/
*.log
# 사이트 HTML/JS 스냅샷 (엔드포인트 재조사용, 커밋 대상 아님)
*.html.snapshot
probe/
